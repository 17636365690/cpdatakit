{
  "profile": "thermal-field",
  "schema_version": "2.0",
  "dimensions": [
    {"name": "time", "length": 4},
    {"name": "y", "length": 3},
    {"name": "x", "length": 4}
  ],
  "coordinates": [
    {"name": "time", "dims": ["time"], "dtype": "float", "unit": "s"},
    {"name": "y", "dims": ["y"], "dtype": "float", "unit": "mm"},
    {"name": "x", "dims": ["x"], "dtype": "float", "unit": "mm"}
  ],
  "variables": [
    {"name": "temperature", "dims": ["time", "y", "x"], "dtype": "float", "unit": "K", "role": "measured_field"}
  ]
}
